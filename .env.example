# Copy to .env — docker compose reads it automatically.
# Everything here is optional; the defaults in docker-compose.yml match these.

# --- Model ---
# Must be a tag Ollama can pull. Changing this re-runs the pull on next `up`.
RP_MODEL=HammerAI/mythomax-l2

# --- Host port the UI is served on ---
RP_PORT=8000

# --- Ollama's port on the host ---
# Exposed so a host-side dev server can share the same GPU and models.
# Ollama has NO authentication — trusted networks only, never port-forward it.
# Leave blank to keep it off the host entirely.
OLLAMA_PORT=11434

# --- Context budget (MythoMax L2 13B is Llama-2 based: 4096 native) ---
RP_CONTEXT_TOKENS=4096
RP_MAX_NEW_TOKENS=400
RP_RESERVE_TOKENS=256

# --- Samplers ---
RP_TEMPERATURE=0.9
RP_TOP_P=0.9
RP_TOP_K=40
RP_REPEAT_PENALTY=1.1

# --- Rolling summarization ---
RP_SUMMARY_ENABLED=true
# Fold once un-summarized history exceeds this many tokens
RP_SUMMARY_TRIGGER_TOKENS=1800
# Recent messages never folded — recency stays verbatim
RP_KEEP_RECENT_MESSAGES=8
RP_SUMMARY_MAX_TOKENS=400
RP_SUMMARY_TEMPERATURE=0.3

# --- Vector retrieval (Phase 4) ---
# Off by default: it needs a second model on the Ollama host
# (`ollama pull nomic-embed-text`). Turn it on from the Memory panel once that
# exists, or set this to true if the model is already pulled.
RP_RETRIEVAL_ENABLED=false
RP_EMBEDDING_MODEL=nomic-embed-text
# Leave blank to use the same host as the chat model.
RP_EMBEDDING_BASE_URL=
# How many past turns to re-inject, and the cosine floor for considering one.
# Below the floor a hit is noise, and irrelevant recall is worse than none.
RP_RETRIEVAL_TOP_K=4
RP_RETRIEVAL_MIN_SCORE=0.45
RP_RETRIEVAL_BUDGET_TOKENS=400
RP_RETRIEVAL_QUERY_MESSAGES=3
