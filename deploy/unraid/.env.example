# Unraid .env — copy to .env next to docker-compose.yml in the Compose Manager stack.

# --- Image ---
# Available once the GHCR workflow has run. GHCR image paths are lowercase even
# when the GitHub username isn't. Pin a `sha-` or version tag instead of
# `latest` if you want deploys to be explicit and rollbacks easy.
RP_IMAGE=ghcr.io/rickxxrolling/roleplay-server:latest

# --- Unraid paths & identity ---
APPDATA=/mnt/user/appdata
PUID=99
PGID=100
TZ=America/New_York

# --- GPU ---
# Leave this as `all` unless you have several cards and genuinely need to pin one.
# A UUID that doesn't match a live card makes the container fail to start with
# "failed to get device handle from UUID: Not Found" — which names no GPU and
# reads like a driver bug. Get exact UUIDs with `nvidia-smi -L` on the host.
NVIDIA_VISIBLE_DEVICES=all

# --- Model ---
RP_MODEL=HammerAI/mythomax-l2

# --- Host port for the web UI ---
RP_PORT=8000

# --- Context budget (MythoMax L2 13B is Llama-2 based: 4096 native) ---
RP_CONTEXT_TOKENS=4096
RP_MAX_NEW_TOKENS=400
RP_RESERVE_TOKENS=256

# --- Samplers ---
RP_TEMPERATURE=0.9
RP_TOP_P=0.9
RP_TOP_K=40
RP_REPEAT_PENALTY=1.1

# --- Rolling summarization ---
RP_SUMMARY_ENABLED=true
RP_SUMMARY_TRIGGER_TOKENS=1800
RP_KEEP_RECENT_MESSAGES=8
RP_SUMMARY_MAX_TOKENS=400
RP_SUMMARY_TEMPERATURE=0.3

# --- Vector recall ---
# The embedding model is pulled at first boot regardless, so switching this on
# in the Memory panel works immediately. Set RP_EMBEDDING_MODEL= (blank) to skip
# that download entirely.
RP_RETRIEVAL_ENABLED=false
RP_EMBEDDING_MODEL=nomic-embed-text
RP_RETRIEVAL_TOP_K=4
RP_RETRIEVAL_MIN_SCORE=0.60
RP_RETRIEVAL_BUDGET_TOKENS=400
RP_RETRIEVAL_QUERY_MESSAGES=3

# --- Ollama's port on the host ---
# Exposed so a workstation can develop against this GPU. Ollama has NO auth —
# trusted LAN only. Leave blank to keep it off the host entirely.
OLLAMA_PORT=11434
