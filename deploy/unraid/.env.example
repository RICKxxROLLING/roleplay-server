# Unraid .env — copy to .env next to docker-compose.yml in the Compose Manager stack.

# --- Image ---
# Replace OWNER with your GitHub username/org once the GHCR workflow has run.
RP_IMAGE=ghcr.io/OWNER/roleplay-server:latest

# --- Unraid paths & identity ---
APPDATA=/mnt/user/appdata
PUID=99
PGID=100
TZ=America/New_York

# --- GPU ---
# `all`, or pin one card with its UUID from Settings → Nvidia Driver
NVIDIA_VISIBLE_DEVICES=all

# --- Model ---
RP_MODEL=mythomax

# --- Host port for the web UI ---
RP_PORT=8000

# --- Context budget (MythoMax L2 13B is Llama-2 based: 4096 native) ---
RP_CONTEXT_TOKENS=4096
RP_MAX_NEW_TOKENS=400
RP_RESERVE_TOKENS=256

# --- Samplers ---
RP_TEMPERATURE=0.9
RP_TOP_P=0.9
RP_TOP_K=40
RP_REPEAT_PENALTY=1.1

# --- Rolling summarization ---
RP_SUMMARY_ENABLED=true
RP_SUMMARY_TRIGGER_TOKENS=1800
RP_KEEP_RECENT_MESSAGES=8
RP_SUMMARY_MAX_TOKENS=400
RP_SUMMARY_TEMPERATURE=0.3
